{
  "name": "ledgeriq",
  "version": "0.1.0",
  "private": true,
  "description": "LedgerIQ — financial reconciliation and spending intelligence",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS='--require ./scripts/netguard.cjs' next dev -H 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS='--require ./scripts/netguard.cjs' next start -H 127.0.0.1",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node e2e/smoke.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "CHECKPOINT_DISABLE=1 prisma generate",
    "doctor": "node scripts/doctor.mjs",
    "reset-password": "CHECKPOINT_DISABLE=1 prisma generate > /dev/null && CHECKPOINT_DISABLE=1 prisma migrate deploy > /dev/null && node --require ./scripts/netguard.cjs scripts/reset-password.mjs",
    "predev": "node scripts/ensure-env.mjs && CHECKPOINT_DISABLE=1 prisma generate && CHECKPOINT_DISABLE=1 prisma migrate deploy",
    "prestart": "node scripts/ensure-env.mjs && CHECKPOINT_DISABLE=1 prisma migrate deploy",
    "prebuild": "CHECKPOINT_DISABLE=1 prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@napi-rs/canvas": "^0.1.100",
    "@prisma/client": "^6.19.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.544.0",
    "next": "15.5.29",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^5.4.296",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
