# Local-only mode (recommended): nothing leaves this computer. Every connection that isn't to this
# computer is refused. Set to "false" ONLY to use bank connections (Plaid) or AI help (Anthropic).
LEDGERIQ_LOCAL_ONLY="true"
# PostgreSQL connection
DATABASE_URL="postgresql://ledgeriq:ledgeriq@localhost:5432/ledgeriq"
# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Used to encrypt original statement files and receipts at rest.
ENCRYPTION_KEY=""
# Optional (needs LEDGERIQ_LOCAL_ONLY="false"): AI interpretation of questions. Sends the question and
# your supplier / category / account names to Anthropic.
# Money totals are ALWAYS computed by database queries, never by the model.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
# Optional: bank connections through Plaid (Accounts → Bank connections).
# Keys from https://dashboard.plaid.com/developers/keys. PLAID_ENV: "sandbox" (test bank) or "production".
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"
# Only for banks that sign you in on their own website (OAuth); register the same URL in the Plaid dashboard.
# PLAID_REDIRECT_URI="http://127.0.0.1:3000/accounts/connections/oauth"
# How often to update connected banks while the app runs (hours).
# BANK_SYNC_HOURS="4"
